% ==============================
% Header / signature
% ==============================
\newcommand{\responseletterheader}{%
  \thispagestyle{plain}%
  \begin{center}
    {\LARGE\sffamily\bfseries\color{ink}\textls[60]{Response Letter}}\\[0.7em]
    {\color{rulegray}\rule{0.28\linewidth}{0.45pt}}\\[0.75em]
    {\normalsize\sffamily\color{inkmuted} Manuscript ID:\ \itshape\printmanusid}
  \end{center}
  \vspace{1.85em}%
}

\newcommand{\responselettersignature}{%
  \par\vspace{1.4em}%
  \noindent Sincerely,\\[0.85em]
  \noindent\printauthors \\[0.55em]
  {\small\color{inkmuted}\printaffiliations}\\[0.35em]
  {\small\color{inkmuted}\printcontactemails}%
  \par
}

% ==============================
% Comment / response environments
% ==============================
\newcounter{commentcounter}
\setcounter{commentcounter}{0}
\newcommand{\resetcommentcounter}{\setcounter{commentcounter}{0}}

\newcommand{\rl@commentlabel}[1]{%
  \noindent{\sffamily\bfseries\footnotesize\color{linkblue}\textls[40]{\MakeUppercase{#1}}}\\[0.45em]%
}

% Indent + italic for comments (page-break friendly; no minipage).
\newcommand{\rl@startcommentbody}{%
  \par\nobreak
  \begingroup
  \color{ink}%
  \itshape
  \setlength{\leftskip}{0.85em}%
  \setlength{\parindent}{0pt}%
  \setlength{\parskip}{0.35em}%
  \noindent\ignorespaces
}
\newcommand{\rl@endcommentbody}{%
  \par
  \endgroup
  \vspace{0.85em}%
}

\newenvironment{generalcomment}{%
  \phantomsection
  \addcontentsline{toc}{subsection}{General Comment}%
  \par\vspace{0.55em}%
  \rl@commentlabel{General Comment}%
  \rl@startcommentbody
}{%
  \rl@endcommentbody
}

\newenvironment{generalresponse}{%
  \par\vspace{0.15em}%
  \rl@commentlabel{General Response}%
  \noindent
  \setlength{\parindent}{0pt}%
}{%
  \par\vspace{0.7em}%
}

\newenvironment{reviewercomment}{%
  \stepcounter{commentcounter}%
  \phantomsection
  \addcontentsline{toc}{subsection}{Comment \thecommentcounter}%
  \par\vspace{0.55em}%
  \rl@commentlabel{Comment \thecommentcounter}%
  \rl@startcommentbody
}{%
  \rl@endcommentbody
}

\newenvironment{reviewerresponse}{%
  \par\vspace{0.15em}%
  \rl@commentlabel{Response}%
  \noindent
  \setlength{\parindent}{0pt}%
}{%
  \par\vspace{0.7em}%
}

\makeatother

\setlist{leftmargin=1.35em, itemsep=0.38em, topsep=0.45em, parsep=0.12em}

\newenvironment{generalblock}{%
  \begin{refsection}%
  \vspace{0.15em}%
}{%
  \par\vspace{0.15em}%
  \renewcommand*{\bibfont}{\footnotesize\normalfont}
  \printbibliography[
    segment=\therefsegment,
    heading=subbibliography,
    title={References},
    resetnumbers=true
  ]%
  \par\vspace{0.9em}%
  {\color{rulegray}\noindent\rule{\linewidth}{0.35pt}}%
  \vspace{1.0em}%
  \end{refsection}%
}

\newenvironment{reviewerblock}{%
  \begin{refsection}%
  \vspace{0.1em}%
}{%
  \par\vspace{0.15em}%
  \renewcommand*{\bibfont}{\footnotesize\normalfont}
  \printbibliography[
    segment=\therefsegment,
    heading=subbibliography,
    title={References},
    resetnumbers=true
  ]%
  \par\vspace{0.9em}%
  {\color{rulegray}\noindent\rule{\linewidth}{0.35pt}}%
  \vspace{1.15em}%
  \end{refsection}%
}

\newcommand{\revisionblock}[1]{%
  \par\addvspace{0.65em}%
  \noindent
  {\color{linkblue}\vrule width 1.5pt}%
  \hspace{0.7em}%
  \begin{minipage}[t]{\dimexpr\linewidth-1.5pt-0.7em\relax}
    \raggedright
    \setlength{\parindent}{0pt}%
    {\color{linkblue}\small\enquote{\dots{} #1 \dots{}}}%
  \end{minipage}%
  \par\addvspace{0.75em}%
}

% ==============================
% Bidirectional jump + append
% ==============================
\makeatletter

\def\@mainpapername{}
\def\@mainpaperlinkname{mainpaper}

\newcommand{\setmainpaper}[1]{%
  \externaldocument{#1}%
  \def\@mainpapername{#1}%
}

\newcommand{\setmainpaperlinkname}[1]{\def\@mainpaperlinkname{#1}}

\newcommand{\revisionbadge}[1]{%
  {\colorbox{badgeblue}{\bfseries\sffamily\scriptsize\textcolor{white}{\,#1\,}}}%
}

\newcommand{\rl@missingbadge}[1]{%
  {\colorbox{inkmuted}{\bfseries\sffamily\scriptsize\textcolor{white}{\,#1?\,}}}%
}

\newcommand{\rl@ensureanchor}[1]{%
  \ifcsname rl@anchor@#1\endcsname
  \else
    \hypertarget{response.#1}{}%
    \global\expandafter\let\csname rl@anchor@#1\endcsname\@empty
  \fi
}

\NewDocumentCommand{\elink}{m}{%
  \rl@ensureanchor{#1}%
  \edef\rl@revlabel{rev:#1}%
  \ifcsname r@\rl@revlabel\endcsname
    \hyperlink{\@mainpaperlinkname.\getpagerefnumber{\rl@revlabel}}{\revisionbadge{#1}}%
  \else
    \rl@missingbadge{#1}%
  \fi
}

\NewDocumentCommand{\elinks}{m}{%
  \def\rl@first{1}%
  \@for\rl@id:=#1\do{%
    \ifnum\rl@first=1\relax
      \def\rl@first{0}%
    \else
      ,\ %
    \fi
    \expandafter\elink\expandafter{\rl@id}%
  }%
}

\NewDocumentCommand{\rlink}{m}{\elink{#1}}
\NewDocumentCommand{\rlinks}{m}{\elinks{#1}}

\newcommand{\appendmainpaper}{%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{section}{Revised Manuscript}%
  \includepdf[
    pages=-,
    link=true,
    linkname=\@mainpaperlinkname,
    linktodoc=true,
    pagecommand={\thispagestyle{empty}}
  ]{\@mainpapername.pdf}%
}

