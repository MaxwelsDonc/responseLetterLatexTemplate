% ==============================
% Header / signature
% ==============================
\newcommand{\responseletterheader}{%
  \thispagestyle{plain}%
  \begin{center}
    {\Large\sffamily\bfseries\color{ink}\textls[50]{Response Letter}}\\[0.4em]
    {\color{rulegray}\rule{0.24\linewidth}{0.4pt}}\\[0.45em]
    {\small\sffamily\color{inkmuted} Manuscript ID:\ \itshape\printmanusid}
  \end{center}
  \vspace{1.1em}%
}

\newcommand{\responselettersignature}{%
  \par\vspace{0.85em}%
  \noindent Sincerely,\\[0.55em]
  \noindent\printauthors \\[0.35em]
  {\small\color{inkmuted}\printaffiliations}\\[0.2em]
  {\small\color{inkmuted}\printcontactemails}%
  \par
}

% ==============================
% Comment / response environments
% ==============================
\newcounter{commentcounter}
\newcounter{rl@replyscope}
\setcounter{commentcounter}{0}
\newcommand{\resetcommentcounter}{\setcounter{commentcounter}{0}}

% Label → body:
% 1) \nointerlineskip cancels setspace baselineskip
% 2) \parskip=0pt so the next \noindent does NOT add another ~0.45em
% 3) fixed 8pt is the only gap under the label
\newcommand{\rl@writelabel}[1]{%
  \par\begingroup
  \setlength{\parindent}{0pt}%
  \noindent{\sffamily\bfseries\footnotesize\color{linkblue}\textls[30]{\MakeUppercase{#1}}}%
  \par\nobreak
  \nointerlineskip
  \vskip 8pt\relax
  \setlength{\parskip}{0pt}%
}
\newcommand{\rl@startbody}{%
  \noindent
  \setlength{\parskip}{0.4em}% later paragraphs in this block breathe a bit
  \ignorespaces
}
\newcommand{\rl@endlabeled}{%
  \par\endgroup
  \vspace{0.15em}%
}

\newenvironment{generalcomment}{%
  \phantomsection
  \addcontentsline{toc}{subsection}{General Comment}%
  \rl@writelabel{General Comment}%
  \color{ink}\itshape
  \rl@startbody
}{%
  \rl@endlabeled
}

\newenvironment{generalresponse}{%
  \stepcounter{rl@replyscope}%
  \rl@writelabel{General Response}%
  \normalfont\color{ink}%
  \rl@startbody
}{%
  \rl@endlabeled
}

\newenvironment{reviewercomment}{%
  \stepcounter{commentcounter}%
  \phantomsection
  \addcontentsline{toc}{subsection}{Comment \thecommentcounter}%
  \rl@writelabel{Comment \thecommentcounter}%
  \color{ink}\itshape
  \rl@startbody
}{%
  \rl@endlabeled
}

\newenvironment{reviewerresponse}{%
  \stepcounter{rl@replyscope}%
  \rl@writelabel{Response}%
  \normalfont\color{ink}%
  \rl@startbody
}{%
  \rl@endlabeled
}

% Mini-references at block end — only when this block actually cited something.
% Never use negative vskips around the bib or the divider: those pulled the
% next rule/text upward into the previous reply (including cite-free blocks).
\newtoggle{rl@blockhascite}
\AtEveryCitekey{\global\toggletrue{rl@blockhascite}}

\newcommand{\rl@printblockbib}{%
  \iftoggle{rl@blockhascite}{%
    \par\vspace{0.35em}%
    \renewcommand*{\bibfont}{\footnotesize\normalfont}%
    \printbibliography[
      segment=\therefsegment,
      heading=subbibliography,
      title={References},
      resetnumbers=true
    ]%
  }{}%
}

% Hairline BETWEEN comment/response units (not under \section, not between
% Comment and Response). Drawn at the *start* of the next block so the last
% block on a reviewer page does not end with a dangling rule.
\newif\ifrl@needblockrule
\newcommand{\rl@maybeblockrule}{%
  \ifrl@needblockrule
    \par
    % Positive gaps only. Slightly less above than below: the previous
    % block already ends with a small \vspace, and the next label needs
    % clear air so it does not look glued to the rule.
    \vspace{0.45em}%
    {\color{rulegray}\noindent\rule{\linewidth}{0.35pt}}%
    \par\nobreak
    \vspace{1.2em}%
  \fi
  \global\rl@needblockruletrue
}

% One Editor / Reviewer section per page. Resets the inter-block rule so the
% first block under the heading is not preceded by a divider.
\newcommand{\responsesection}[1]{%
  \clearpage
  \global\rl@needblockrulefalse
  \section{#1}%
}

\newenvironment{generalblock}{%
  \rl@maybeblockrule
  \global\togglefalse{rl@blockhascite}%
  \begin{refsection}%
}{%
  \rl@printblockbib
  \par\vspace{0.25em}%
  \end{refsection}%
}

\newenvironment{reviewerblock}{%
  \rl@maybeblockrule
  \global\togglefalse{rl@blockhascite}%
  \begin{refsection}%
}{%
  \rl@printblockbib
  \par\vspace{0.25em}%
  \end{refsection}%
}

\makeatother

\newcommand{\revisionblock}[1]{%
  \par\addvspace{0.25em}%
  \noindent
  {\color{linkblue}\vrule width 1.25pt}%
  \hspace{0.55em}%
  \begin{minipage}[t]{\dimexpr\linewidth-1.25pt-0.55em\relax}
    \raggedright
    \setlength{\parindent}{0pt}%
    \setlength{\parskip}{0.25em}%
    {\color{linkblue}\small\enquote{\dots{} #1 \dots{}}}%
  \end{minipage}%
  \par\addvspace{0.35em}%
}

% ==============================
% Bidirectional jump + append
% ==============================
\makeatletter

\def\@mainpapername{}
\def\@mainpaperlinkname{mainpaper}
\newif\ifmanagedreviewlinks
\ifdefined\BuildManagedReviewPDF\managedreviewlinkstrue\fi

\newcommand{\setmainpaper}[1]{%
  \externaldocument{#1}%
  \def\@mainpapername{#1}%
}

\newcommand{\setmainpaperlinkname}[1]{\def\@mainpaperlinkname{#1}}

\newcommand{\revisionbadge}[1]{%
  {\colorbox{badgeblue}{\bfseries\sffamily\scriptsize\textcolor{white}{\,#1\,}}}%
}

% The PDF linker places the same vector badge on the manuscript margin.
\newsavebox{\rl@badgebox}
\newcommand{\rl@reviewbadge}[1]{%
  \ifcsname rl@badgeobject@#1\endcsname\else
    \sbox{\rl@badgebox}{\revisionbadge{#1}}%
    \immediate\pdfxform attr{/ReviewBadge (\pdfescapestring{#1})}\rl@badgebox
    \expandafter\xdef\csname rl@badgeobject@#1\endcsname{\the\pdflastxform}%
  \fi
  \pdfrefxform\csname rl@badgeobject@#1\endcsname\relax
}

\newcommand{\rl@missingbadge}[1]{%
  {\colorbox{inkmuted}{\bfseries\sffamily\scriptsize\textcolor{white}{\,#1?\,}}}%
}

\newcommand{\rl@ensureanchor}[1]{%
  \ifcsname rl@anchor@#1\endcsname
  \else
    \hypertarget{response.#1}{}%
    \global\expandafter\let\csname rl@anchor@#1\endcsname\@empty
  \fi
}

\newcommand{\rl@combinedlink}[1]{%
  \rl@ensureanchor{#1}%
  \edef\rl@revlabel{rev:#1}%
  \ifcsname r@\rl@revlabel\endcsname
    \hyperlink{\@mainpaperlinkname.\getpagerefnumber{\rl@revlabel}}{\revisionbadge{#1}}%
  \else
    \rl@missingbadge{#1}%
  \fi
}

% Read by the PDF linker from the compiled letter's auxiliary file.
\newcommand{\ReviewLinkRecord}[2]{}

\newcommand{\rl@reviewlink}[2]{%
  \ifcsname rl@reply@#2\endcsname
    \ifnum\csname rl@reply@#2\endcsname=\value{rl@replyscope}\relax\else
      \PackageError{commands}{Reply ID #2 is used in multiple responses}{}%
    \fi
  \else
    \expandafter\xdef\csname rl@reply@#2\endcsname{\number\value{rl@replyscope}}%
    \hypertarget{reply.#2}{}%
  \fi
  \protected@write\@auxout{}{\string\ReviewLinkRecord{#2}{#1}}%
  \href{manuscript.pdf\#revision.#1}{\rl@reviewbadge{#1}}%
  \ifcsname r@rev:#1\endcsname
    \protected@edef\rl@sectiontitle{\getrefbykeydefault{rev:#1}{name}{}}%
    {\footnotesize\ (p.~\getpagerefnumber{rev:#1}%
      \ifx\rl@sectiontitle\@empty\else, \rl@sectiontitle\fi)}%
  \fi
}

\newcommand{\rl@elink}[2]{%
  \ifmanagedreviewlinks
    \IfValueTF{#2}{\rl@reviewlink{#1}{#2}}{%
      \edef\rl@replyid{response-\number\value{rl@replyscope}}%
      \rl@reviewlink{#1}{\rl@replyid}%
    }%
  \else
    \rl@combinedlink{#1}%
  \fi
}

\NewDocumentCommand{\elink}{o m}{\rl@elink{#2}{#1}}

\NewDocumentCommand{\elinks}{o m}{%
  \def\rl@first{1}%
  \@for\rl@id:=#2\do{%
    \ifnum\rl@first=1\relax
      \def\rl@first{0}%
    \else
      ,\ %
    \fi
    \expandafter\rl@elink\expandafter{\rl@id}{#1}%
  }%
}

\NewCommandCopy\rlink\elink
\NewCommandCopy\rlinks\elinks

\newcommand{\appendmainpaper}{%
  \ifmanagedreviewlinks\else
  \clearpage
  \phantomsection
  \addcontentsline{toc}{section}{Revised Manuscript}%
  \includepdf[
    pages=-,
    link=true,
    linkname=\@mainpaperlinkname,
    linktodoc=true,
    pagecommand={\thispagestyle{empty}}
  ]{\@mainpapername.pdf}%
  \fi
}

