        {\large \textit{Manuscript ID: \printmanusid}}
    \end{center}
    \vspace{2em}%
}

\newcommand{\responselettersignature}{%
    \begin{flushleft}
        Sincerely,\\[0.3em]
        \printauthors \\[0.3em]
