% ==============================
% Header / signature
% ==============================
\newcommand{\responseletterheader}{%
  \thispagestyle{plain}%
  \begin{center}
    {\Large\sffamily\bfseries\color{ink}\textls[50]{Response Letter}}\\[0.4em]
    {\color{rulegray}\rule{0.24\linewidth}{0.4pt}}\\[0.45em]
    {\small\sffamily\color{inkmuted} Manuscript ID:\ \itshape\printmanusid}
  \end{center}
  \vspace{1.1em}%
}

\newcommand{\responselettersignature}{%
  \par\vspace{0.85em}%
  \noindent Sincerely,\\[0.55em]
  \noindent\printauthors \\[0.35em]
  {\small\color{inkmuted}\printaffiliations}\\[0.2em]
  {\small\color{inkmuted}\printcontactemails}%
  \par
}

% ==============================
% Comment / response environments
% ==============================
\newcounter{commentcounter}
\setcounter{commentcounter}{0}
\newcommand{\resetcommentcounter}{\setcounter{commentcounter}{0}}

% Label → body:
% 1) \nointerlineskip cancels setspace baselineskip
% 2) \parskip=0pt so the next \noindent does NOT add another ~0.45em
% 3) fixed 8pt is the only gap under the label
\newcommand{\rl@writelabel}[1]{%
  \par\begingroup
  \setlength{\parindent}{0pt}%
  \noindent{\sffamily\bfseries\footnotesize\color{linkblue}\textls[30]{\MakeUppercase{#1}}}%
  \par\nobreak
  \nointerlineskip
  \vskip 8pt\relax
  \setlength{\parskip}{0pt}%
}
\newcommand{\rl@startbody}{%
  \noindent
  \setlength{\parskip}{0.4em}% later paragraphs in this block breathe a bit
  \ignorespaces
}
\newcommand{\rl@endlabeled}{%
  \par\endgroup
  \vspace{0.55em}%
}

\newenvironment{generalcomment}{%
  \phantomsection
  \addcontentsline{toc}{subsection}{General Comment}%
  \rl@writelabel{General Comment}%
  \color{ink}\itshape
  \rl@startbody
}{%
  \rl@endlabeled
}

\newenvironment{generalresponse}{%
  \rl@writelabel{General Response}%
  \normalfont\color{ink}%
  \rl@startbody
}{%
  \rl@endlabeled
}

\newenvironment{reviewercomment}{%
  \stepcounter{commentcounter}%
  \phantomsection
  \addcontentsline{toc}{subsection}{Comment \thecommentcounter}%
  \rl@writelabel{Comment \thecommentcounter}%
  \color{ink}\itshape
  \rl@startbody
}{%
  \rl@endlabeled
}

\newenvironment{reviewerresponse}{%
  \rl@writelabel{Response}%
  \normalfont\color{ink}%
  \rl@startbody
}{%
  \rl@endlabeled
}

% Hairline after each comment/response unit (not under \section).
\newcommand{\rl@blockrule}{%
  \par\vspace{0.35em}%
  {\color{rulegray}\noindent\rule{\linewidth}{0.35pt}}%
  \par\vspace{0.7em}%
}

% Print a mini-references list only when this block actually cited something.
\newcommand{\rl@printblockbib}{%
  \par
  \renewcommand*{\bibfont}{\footnotesize\normalfont}%
  \printbibliography[
    segment=\therefsegment,
    heading=subbibliography,
    title={References},
    resetnumbers=true
  ]%
}

\newenvironment{generalblock}{%
  \begin{refsection}%
}{%
  \rl@printblockbib
  \rl@blockrule
  \end{refsection}%
}

\newenvironment{reviewerblock}{%
  \begin{refsection}%
}{%
  \rl@printblockbib
  \rl@blockrule
  \end{refsection}%
}

\makeatother

\newcommand{\revisionblock}[1]{%
  \par\addvspace{0.25em}%
  \noindent
  {\color{linkblue}\vrule width 1.25pt}%
  \hspace{0.55em}%
  \begin{minipage}[t]{\dimexpr\linewidth-1.25pt-0.55em\relax}
    \raggedright
    \setlength{\parindent}{0pt}%
    \setlength{\parskip}{0.25em}%
    {\color{linkblue}\small\enquote{\dots{} #1 \dots{}}}%
  \end{minipage}%
  \par\addvspace{0.35em}%
}

% ==============================
% Bidirectional jump + append
% ==============================
\makeatletter

\def\@mainpapername{}
\def\@mainpaperlinkname{mainpaper}

\newcommand{\setmainpaper}[1]{%
  \externaldocument{#1}%
  \def\@mainpapername{#1}%
}

\newcommand{\setmainpaperlinkname}[1]{\def\@mainpaperlinkname{#1}}

\newcommand{\revisionbadge}[1]{%
  {\colorbox{badgeblue}{\bfseries\sffamily\scriptsize\textcolor{white}{\,#1\,}}}%
}

\newcommand{\rl@missingbadge}[1]{%
  {\colorbox{inkmuted}{\bfseries\sffamily\scriptsize\textcolor{white}{\,#1?\,}}}%
}

\newcommand{\rl@ensureanchor}[1]{%
  \ifcsname rl@anchor@#1\endcsname
  \else
    \hypertarget{response.#1}{}%
    \global\expandafter\let\csname rl@anchor@#1\endcsname\@empty
  \fi
}

\NewDocumentCommand{\elink}{m}{%
  \rl@ensureanchor{#1}%
  \edef\rl@revlabel{rev:#1}%
  \ifcsname r@\rl@revlabel\endcsname
    \hyperlink{\@mainpaperlinkname.\getpagerefnumber{\rl@revlabel}}{\revisionbadge{#1}}%
  \else
    \rl@missingbadge{#1}%
  \fi
}

\NewDocumentCommand{\elinks}{m}{%
  \def\rl@first{1}%
  \@for\rl@id:=#1\do{%
    \ifnum\rl@first=1\relax
      \def\rl@first{0}%
    \else
      ,\ %
    \fi
    \expandafter\elink\expandafter{\rl@id}%
  }%
}

\NewDocumentCommand{\rlink}{m}{\elink{#1}}
\NewDocumentCommand{\rlinks}{m}{\elinks{#1}}

\newcommand{\appendmainpaper}{%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{section}{Revised Manuscript}%
  \includepdf[
    pages=-,
    link=true,
    linkname=\@mainpaperlinkname,
    linktodoc=true,
    pagecommand={\thispagestyle{empty}}
  ]{\@mainpapername.pdf}%
}

