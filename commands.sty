% Quote a revised sentence inside the response letter.
\newcommand{\revisionblock}[1]{%
  \begin{quote}
  {\color{blue}\enquote{\dots{} #1 \dots{}}}
  \end{quote}
}

% ==============================
% Bidirectional jump + append
% ==============================
\makeatletter

\def\@mainpapername{}
\def\@mainpaperlinkname{mainpaper}

\newcommand{\setmainpaper}[1]{%
    \externaldocument{#1}%
    \def\@mainpapername{#1}%
}

% Optional: override pdfpages linkname prefix (default: mainpaper).
\newcommand{\setmainpaperlinkname}[1]{\def\@mainpaperlinkname{#1}}

\newcommand{\revisionbadge}[1]{%
  {\colorbox{blue}{\bfseries\sffamily\scriptsize\textcolor{white}{#1}}}%
}

% Missing-target placeholder (still creates the response.<id> anchor).
\newcommand{\rl@missingbadge}[1]{%
  {\colorbox{gray}{\bfseries\sffamily\scriptsize\textcolor{white}{#1?}}}%
}

% Response-letter side forward link.
% Creates named destination response.<id> and jumps to the appended manuscript page
% that contains \label{rev:<id>} (via xr-hyper + pdfpages linkname).
\NewDocumentCommand{\rlink}{m}{%
  \hypertarget{response.#1}{}%
  \edef\rl@revlabel{rev:#1}%
  \ifcsname r@\rl@revlabel\endcsname
    \hyperlink{\@mainpaperlinkname.\getpagerefnumber{\rl@revlabel}}{\revisionbadge{#1}}%
  \else
    \rl@missingbadge{#1}%
  \fi
}

% Convenience: one or more forward links in a sentence.
% \rlinks{r1c1a,r1c1b} -> badges separated by commas.
\NewDocumentCommand{\rlinks}{m}{%
  \def\rl@first{1}%
  \@for\rl@id:=#1\do{%
    \ifnum\rl@first=1\relax
      \def\rl@first{0}%
    \else
      ,\ %
    \fi
    \expandafter\rlink\expandafter{\rl@id}%
  }%
}

\newcommand{\appendmainpaper}{%
    \newpage
    \phantomsection
    \addcontentsline{toc}{section}{Appended Manuscript}%
    \includepdf[
      pages=-,
      link=true,
      linkname=\@mainpaperlinkname,
      linktodoc=true
    ]{\@mainpapername.pdf}%
}

