\ProvidesPackage{revision-marks}[2026/11/02 Unified revision marks for response-letter workflow]
%
% Manuscript-side API (copy this file into any paper project):
%
%   \setresponseletter{responseLetter}   % PDF basename of the response letter
%   \revise[r1c1a]{revised text here}    % recommended: id + badge + blue text
%   \rpoint{r1c1a}                       % location-only badge (figure/table/etc.)
%
% Legacy (still supported):
%   \rlabel{r1c1a}\revise{revised text}  % id from the previous \rlabel
%
% Switches:
%   \showrevmarkstrue / \showrevmarksfalse
%     hide badges + blue coloring; labels are always written

\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{xparse}

\makeatletter

\newif\ifshowrevmarks
\showrevmarkstrue

\def\rl@responseletter{responseLetter}
\newcommand{\setresponseletter}[1]{\def\rl@responseletter{#1}}

\def\currentrid{}

\newcommand{\revisionbadge}[1]{%
  {\colorbox{blue}{\bfseries\sffamily\scriptsize\textcolor{white}{#1}}}%
}

% Back-link into the response letter named destination response.<id>
\newcommand{\revref}[1]{%
  \href{\rl@responseletter.pdf\#nameddest=response.#1}{\revisionbadge{#1}}%
}

\newcommand{\rl@writelabel}[1]{%
  \label{rev:#1}%
}

% Set id + write label, no visible mark. Used by legacy \rlabel{...}\revise{...}.
\newcommand{\rlabel}[1]{%
  \def\currentrid{#1}%
  \rl@writelabel{#1}%
}

% Location mark: label + visible badge (no revised body text).
\newcommand{\rpoint}[1]{%
  \rlabel{#1}%
  \ifshowrevmarks
    \revref{#1}%
  \fi
}

% Primary command.
%   \revise[id]{text}  -- bind id explicitly (recommended)
%   \revise{text}      -- use \currentrid from the last \rlabel/\rpoint
\NewDocumentCommand{\revise}{o m}{%
  \IfValueTF{#1}{%
    \def\currentrid{#1}%
    \rl@writelabel{#1}%
  }{%
    \ifx\currentrid\@empty
      \PackageError{revision-marks}{%
        \string\revise\space used without an id.\MessageBreak
        Use \string\revise[id]{text} or call \string\rlabel{id} first%
      }{Add an optional id argument.}%
    \fi
  }%
  \ifshowrevmarks
    \revref{\currentrid}~{\color{blue}#2}%
  \else
    #2%
  \fi
}

\makeatother
\endinput
